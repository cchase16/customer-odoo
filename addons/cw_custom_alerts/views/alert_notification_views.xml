<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_alert_notification_tree" model="ir.ui.view">
        <field name="name">alert.notification.tree</field>
        <field name="model">alert.notification</field>
        <field name="arch" type="xml">
            <list string="My Alerts" create="0" delete="0">
                <field name="state"/>
                <field name="severity" widget="badge"/>
                <field name="subject"/>
                <field name="message"/>
                <field name="occurred_at"/>
                <field name="read_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_alert_notification_form" model="ir.ui.view">
        <field name="name">alert.notification.form</field>
        <field name="model">alert.notification</field>
        <field name="arch" type="xml">
            <form string="Alert Details" create="0" edit="0" delete="0">
                <header>
                    <button name="action_mark_read" type="object" string="Mark as read"
                            class="btn-primary" invisible="state != 'unread'"/>
                    <button name="action_open_source" type="object" string="Open source"
                            invisible="not res_id"/>
                </header>
                <sheet>
                    <group>
                        <field name="subject"/>
                        <field name="severity"/>
                        <field name="state"/>
                        <field name="occurred_at"/>
                        <field name="email_state"/>
                        <field name="email_error_summary" optional="hide"/>
                        <field name="rule_name_snapshot"/>
                        <field name="model_label"/>
                        <field name="record_name_snapshot"/>
                        <field name="email_state"/>
                        <field name="email_error_summary"/>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1"/>
                    </group>
                    <group string="Event Values" invisible="not field_name">
                        <field name="field_label"/>
                        <field name="old_value_text"/>
                        <field name="new_value_text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_alert_notification_search" model="ir.ui.view">
        <field name="name">alert.notification.search</field>
        <field name="model">alert.notification</field>
        <field name="arch" type="xml">
            <search string="My Alerts">
                <field name="subject"/>
                <field name="model_name"/>
                <field name="state"/>
                <field name="severity"/>
                <filter name="unread" string="Unread" domain="[('state', '=', 'unread')]"/>
                <filter name="read" string="Read" domain="[('state', '=', 'read')]"/>
                <filter name="dismissed" string="Dismissed" domain="[('state', '=', 'dismissed')]"/>
                <group>
                    <filter name="group_severity" string="Severity" context="{'group_by': 'severity'}"/>
                    <filter name="group_rule" string="Rule" context="{'group_by': 'rule_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_alert_notifications" model="ir.actions.act_window">
        <field name="name">My Alerts</field>
        <field name="res_model">alert.notification</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_alert_notification_tree"/>
        <field name="search_view_id" ref="view_alert_notification_search"/>
        <field name="domain">[('user_id', '=', uid)]</field>
    </record>

    <menuitem id="menu_alert_notifications" name="My Alerts"
              action="action_alert_notifications" sequence="81"
              groups="cw_custom_alerts.group_alert_user"/>
</odoo>
