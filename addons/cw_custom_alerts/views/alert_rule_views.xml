<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_alert_rule_tree" model="ir.ui.view">
        <field name="name">alert.rule.tree</field>
        <field name="model">alert.rule</field>
        <field name="arch" type="xml">
            <list string="My Alert Rules">
                <field name="name"/>
                <field name="status"/>
                <field name="event_type"/>
                <field name="model_id"/>
                <field name="recipient_user_id"/>
                <field name="trigger_count"/>
                <field name="suppressed_count"/>
                <field name="last_triggered_at"/>
            </list>
        </field>
    </record>
    <record id="view_alert_rule_form" model="ir.ui.view">
        <field name="name">alert.rule.form</field>
        <field name="model">alert.rule</field>
        <field name="arch" type="xml">
            <form string="Alert Rule">
                <header>
                    <button name="action_activate" type="object" string="Resume" class="btn-primary" invisible="status == 'active'"/>
                    <button name="action_pause" type="object" string="Pause" invisible="status != 'active'"/>
                    <button name="action_archive" type="object" string="Archive"/>
                    <button name="action_recapture" type="object" string="Recapture Scope" invisible="scope_type != 'captured_domain'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,active,paused,expired,error"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="creator_user_id" readonly="1"/>
                        <field name="recipient_user_id"/>
                        <field name="model_id"/>
                        <field name="field_id" domain="[('model_id', '=', model_id)]"/>
                        <field name="event_type"/>
                        <field name="scope_type"/>
                        <field name="target_res_id" invisible="scope_type != 'current_record'"/>
                        <field name="scope_domain_json" invisible="scope_type != 'captured_domain'"/>
                        <field name="condition_domain_json"/>
                    </group>
                    <group string="Contents">
                        <field name="subject_template"/>
                        <field name="message_template"/>
                        <field name="severity"/>
                        <field name="send_email"/>
                        <field name="expires_at"/>
                    </group>
                    <group string="Diagnostics">
                        <field name="trigger_count" readonly="1"/>
                        <field name="suppressed_count" readonly="1"/>
                        <field name="last_triggered_at" readonly="1"/>
                        <field name="last_error_at" readonly="1"/>
                        <field name="last_error_summary" readonly="1"/>
                        <field name="automation_id" groups="cw_custom_alerts.group_alert_manager" readonly="1"/>
                        <field name="server_action_id" groups="cw_custom_alerts.group_alert_manager" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_alert_rule_search" model="ir.ui.view">
        <field name="name">alert.rule.search</field>
        <field name="model">alert.rule</field>
        <field name="arch" type="xml">
            <search string="Alert Rules">
                <field name="name"/>
                <field name="model_id"/>
                <field name="status"/>
                <filter name="my_rules" string="My Rules" domain="[('creator_user_id', '=', uid)]"/>
                <filter name="active_rules" string="Active" domain="[('status', '=', 'active')]"/>
                <group>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_model" string="Watched Model" context="{'group_by': 'model_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_alert_rules" model="ir.actions.act_window">
        <field name="name">My Alert Rules</field>
        <field name="res_model">alert.rule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_alert_rule_search"/>
    </record>
    <menuitem id="menu_alert_rules" name="My Alert Rules" action="action_alert_rules" sequence="80" groups="cw_custom_alerts.group_alert_user"/>
</odoo>
