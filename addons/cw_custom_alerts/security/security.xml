<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_custom_alerts" model="res.groups.privilege">
        <field name="name">Custom Alerts</field>
        <field name="category_id" ref="base.module_category_tools"/>
    </record>
    <record id="group_alert_user" model="res.groups">
        <field name="name">Alert User</field>
        <field name="privilege_id" ref="cw_custom_alerts.res_groups_privilege_custom_alerts"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_alert_manager" model="res.groups">
        <field name="name">Alert Manager</field>
        <field name="privilege_id" ref="cw_custom_alerts.res_groups_privilege_custom_alerts"/>
        <field name="implied_ids" eval="[(4, ref('cw_custom_alerts.group_alert_user'))]"/>
    </record>

    <record id="rule_alert_rule_owner" model="ir.rule">
        <field name="name">Alert rules: creator access</field>
        <field name="model_id" ref="cw_custom_alerts.model_alert_rule"/>
        <field name="domain_force">[('creator_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('cw_custom_alerts.group_alert_user'))]"/>
    </record>
    <record id="rule_alert_rule_manager" model="ir.rule">
        <field name="name">Alert rules: manager access</field>
        <field name="model_id" ref="cw_custom_alerts.model_alert_rule"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('cw_custom_alerts.group_alert_manager'))]"/>
    </record>
    <record id="rule_alert_notification_recipient" model="ir.rule">
        <field name="name">Alert notifications: recipient access</field>
        <field name="model_id" ref="cw_custom_alerts.model_alert_notification"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('cw_custom_alerts.group_alert_user'))]"/>
    </record>
    <record id="rule_alert_notification_manager" model="ir.rule">
        <field name="name">Alert notifications: manager access</field>
        <field name="model_id" ref="cw_custom_alerts.model_alert_notification"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('cw_custom_alerts.group_alert_manager'))]"/>
    </record>
</odoo>
