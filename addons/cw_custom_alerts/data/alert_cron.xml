<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_alert_notification_retention" model="ir.cron">
        <field name="name">Custom Alerts: retention cleanup</field>
        <field name="model_id" ref="model_alert_notification"/>
        <field name="state">code</field>
        <field name="code">model._run_retention()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=2, minute=0, second=0)"/>
        <field name="active">True</field>
    </record>
</odoo>
